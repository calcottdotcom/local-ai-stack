# ── GPU ────────────────────────────────────────────────────────────────────
# Detected and set by 'just setup'. Values: nvidia | amd
GPU_TYPE=nvidia

# ── Inference provider ─────────────────────────────────────────────────────
# Set automatically by 'just up ollama' or 'just up llamacpp'. Values: ollama | llamacpp
INFERENCE_PROVIDER=ollama

# OpenAI-compatible base URL used by agents (set by 'just up')
INFERENCE_BASE_URL=http://ollama:11434/v1

# Active model name passed to agents (set by 'just download' and 'just up')
INFERENCE_MODEL=

# Last downloaded Ollama model — kept so agents know which model to use
# even when llamacpp is the active provider (set by 'just download ollama')
OLLAMA_MODEL=

# Context window set in the ollama modelfile (set by 'just download ollama')
OLLAMA_CTX=

# OpenWebUI-specific vars (set by 'just up')
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_BASE_URL=

# ── Host UID/GID (used by hermes-webui for volume permissions) ─────────────
# Find yours with: id -u  and  id -g
HOST_UID=1000
HOST_GID=1000

# ── Ports (host-side) ──────────────────────────────────────────────────────
OLLAMA_PORT=11435
LLAMACPP_PORT=8089
OPENWEBUI_PORT=8086
SEARXNG_PORT=8888
HERMES_PORT=8787
SERVER_PORT=8087
COMFYUI_PORT=8188
OPENDESIGN_PORT=7456

# ── Llama.cpp ──────────────────────────────────────────────────────────────
# Model filename inside the llamacpp-models volume (set by 'just download llamacpp')
LLAMACPP_MODEL=

# Context window size passed to llama-server (set by 'just download llamacpp')
LLAMACPP_CTX=8192

# Number of layers to offload to GPU (-1 = all)
LLAMACPP_GPU_LAYERS=99

# KV cache quantization type passed as -ctk/-ctv to llama-server.
# Standard image (just up llamacpp): f16 | q4_0 | q8_0
# TurboQuant image (just up llamacpp-tq): turbo3 (4.3× compression, recommended) | turbo2 | turbo4
LLAMACPP_KV_TYPE=f16

# Extra flags appended verbatim to the llama-server command line.
# MTP speculative decoding (just up llamacpp-tq only) — requires a matching
# --spec-draft-model file; see docs/benchmarks/llamacpp-rtx4080-12gb.md.
LLAMACPP_EXTRA_ARGS=

# ── OpenDesign (served by pi container on port 7456) ───────────────────────
# Required. Generate with: openssl rand -hex 32
OD_API_TOKEN=
